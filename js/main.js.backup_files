    try {
        // Simuler un délai de chargement (remplacer par vraie API)
        await new Promise(resolve => setTimeout(resolve, 1000));
        
        // Données d'exemple (remplacer par vraies données)
        const sampleData = [
            {
                date: '15/10/2025',
